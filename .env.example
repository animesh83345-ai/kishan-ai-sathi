# Copy this file to .env and populate it with values from your own accounts.
# Never commit .env or put server credentials in frontend variables.
GEMINI_API_KEY=

# Exotel credentials and region (server only)
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_CALLER_ID=
EXOTEL_REGION=mumbai

# Public HTTPS origin serving this Node application and its WebSocket endpoint
PUBLIC_BASE_URL=

# Generate three distinct random secrets of at least 32 characters
EXOTEL_STREAM_TOKEN=
EXOTEL_STATUS_WEBHOOK_TOKEN=
CALL_OPERATOR_TOKEN=

# Optional server port (defaults to 3000)
PORT=3001
